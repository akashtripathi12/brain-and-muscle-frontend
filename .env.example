# THE BRAIN DASHBOARD - ENVIRONMENT TEMPLATE
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit your .env.local file to version control.


# 1. SUPABASE CONFIGURATION
# Obtained from Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here


# 2. BRAIN CONTROL PLANE CONFIGURATION
# The URL where the Go Brain service is listening (Default: http://localhost:8888)
NEXT_PUBLIC_BRAIN_URL=http://localhost:8888

# The Secret Key used to authenticate with the Brain API.
# This must match the AUTH_SECRET_KEY defined in the Brain backend.
NEXT_PUBLIC_BRAIN_API_KEY=your_brain_secret_key_here


# 3. PUBLIC SITE CONFIGURATION
# The base URL of this frontend (used for auth redirects)
# Dev: http://localhost:3000 | Prod: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# 4. GITHUB APP CONFIGURATION
GITHUB_APP_ID=your_github_app_id_here
GITHUB_APP_CLIENT_ID=your_github_app_client_id_here
GITHUB_APP_CLIENT_SECRET=your_github_app_client_secret_here
# Replace line breaks with \n if placing on a single line, or wrap in quotes
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"


# 5. WEBHOOK CONFIGURATION (OPTIONAL)
# If you are using Ngrok for local webhook testing, set this to your Ngrok URL
# BRAIN_WEBHOOK_URL=https://your-ngrok-id.ngrok-free.app
